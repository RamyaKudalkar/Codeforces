#include<iostream>
using namespace std;
 
int main()
{
    int t;
    cin>>t;
    while(t--){
        int n,k;
        cin>>n>>k;
        bool flag=false;
        while(n--){
            int a;
            cin>>a;
            if(a==k)
                flag=true;
        }
        if(flag)
            cout<<"YES
";
        else
            cout<<"NO
";
    }
    return 0;
}